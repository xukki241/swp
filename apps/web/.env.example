# API Configuration
# These variables are baked into the build at compile time
# For local development
VITE_API_URL=http://localhost:3000/api

# For Docker builds with local API
# VITE_API_URL=http://localhost:3000/api

# For Docker Compose with local API
# VITE_API_URL=http://api:3000/api

# For Azure/Production (using nginx proxy)
# Frontend calls /api, nginx forwards to actual API server
# VITE_API_URL=/api

# For Azure/Production (direct API calls - alternative approach)
# VITE_API_URL=https://pharmaflow-api-next.azurewebsites.net/api
# VITE_API_URL=https://pharmaflow-api-prod.azurewebsites.net/api
