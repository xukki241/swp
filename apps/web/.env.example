# API Configuration
# For local development with Vite dev server
# This is the target URL that Vite will proxy /api requests to
VITE_API_URL=http://localhost:3000

# Legacy variable (kept for backward compatibility)
VITE_API_BASE_URL=http://localhost:3000/api

# For Docker/Production (used by nginx at runtime)
# Uncomment and set based on your environment:

# Local Docker
# API_URL=http://api:3000

# Azure Next (Staging)
# API_URL=https://pharmaflow-api-next.azurewebsites.net

# Azure Production
# API_URL=https://pharmaflow-api-prod.azurewebsites.net

# Environment
ENVIRONMENT=development
