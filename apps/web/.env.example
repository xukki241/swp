# API Configuration
# These variables are baked into the build at compile time
# For local development
VITE_API_URL=http://localhost:3000/api

# For Docker builds with local API
# VITE_API_URL=http://localhost:3000/api

# For Docker Compose with local API
# VITE_API_URL=http://api:3000/api

# For Azure Staging (Next)
# VITE_API_URL=https://pharmaflow-api-next.azurewebsites.net

# For Azure Production
# VITE_API_URL=https://pharmaflow-api-prod.azurewebsites.net
