# Test Environment Variables
NODE_ENV=test

# Database Configuration (Test Database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmaflow_test
DB_USER=postgres
DB_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/pharmaflow_test

# Server Configuration
PORT=3001
API_BASE_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=test_jwt_secret_key_for_testing_only
JWT_EXPIRES_IN=1h

# Email Configuration (Use test settings)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=testpassword
SMTP_FROM=noreply@pharmaflow-test.com

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=error
LOG_DIR=./logs