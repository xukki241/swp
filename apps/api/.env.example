# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production)
DATABASE_URL=postgresql://username:password@localhost:5432/pharmacy_db

# Option 2: Use individual database components (alternative to DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=pharmacy_db

# Database Pool Configuration (optional)
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Database SSL Configuration (optional)
# Set to "true" to enable SSL connections
DB_SSL=false