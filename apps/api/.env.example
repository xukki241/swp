# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_PREFIX=/api

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_CREDENTIALS=true

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pharmaflow

# Individual PostgreSQL connection parameters (used if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=pharmaflow

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Email Configuration (Gmail - For OTP/Password Reset)
# Get App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pharmaflow@gmail.com
SMTP_PASS=zutp ilbh leqi mcqi
SMTP_FROM=PharmaFlow <noreply@pharmaflow.com>

# SMS Configuration
# Choose provider: 'twilio', 'esms', or 'custom'
SMS_PROVIDER=twilio

# Twilio Configuration (International SMS)
# Sign up: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ESMS.vn Configuration (Vietnamese SMS Gateway)
# Sign up: https://esms.vn
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=PharmaFlow

# Custom SMS API (Your own gateway)
CUSTOM_SMS_API_URL=
CUSTOM_SMS_API_KEY=

# Google AI Configuration (Gemini API)
# Get API Key: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key-here