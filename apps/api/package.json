{
  "name": "@pharmaflow/api",
  "displayName": "PharmaFlow API",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Express.js API server",
  "_moduleAliases": {
    "@": "src"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "@pharmaflow/dto": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "module-alias": "^2.2.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@pharmaflow/repoconfig": "workspace:*",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
