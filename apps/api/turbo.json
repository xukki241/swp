{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "db:generate": {
      "cache": false,
      "inputs": ["src/db/schema/**", "drizzle.config.js", ".env"]
    },
    "db:migrate": {
      "cache": false,
      "inputs": ["src/db/migrations/**", ".env"]
    },
    "db:push": {
      "cache": false,
      "inputs": ["src/db/schema/**", "drizzle.config.js", ".env"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "inputs": [".env"]
    },
    "db:drop": {
      "cache": false,
      "inputs": [".env"]
    },
    "db:seed": {
      "cache": false,
      "inputs": [".env"]
    }
  }
}
