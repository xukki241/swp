{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["lint", "^build"],
      "inputs": ["package.json", "src/**", "tsconfig.json"],
      "outputs": ["build/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["**/*.{js,ts,jsx,tsx}", "**/*.config.*", "package.json"]
    },
    "preview": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["package.json", "build/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.json"]
    }
  }
}
