# Docker Compose Environment Variables
# Copy this file to .env and update the values

# Docker Image Configuration (for production deployments using registry images)
# DOCKER_IMAGE_API=registry.gitlab.com/your-group/pharmaflow/api
# DOCKER_IMAGE_WEB=registry.gitlab.com/your-group/pharmaflow/web
# DOCKER_IMAGE_TAG=production  # or 'next' for staging

# Node Environment
NODE_ENV=production

# Database Configuration
DB_USER=pharmaflow
DB_PASSWORD=pharmaflow_password
DB_NAME=pharmaflow_db
DB_PORT=5432

# API Configuration
API_PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:80

# Web Configuration
WEB_PORT=80
API_URL=http://api:3000
ENVIRONMENT=production

# pgAdmin Configuration (optional - use with: docker-compose --profile tools up)
PGADMIN_EMAIL=admin@pharmaflow.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Additional API Environment Variables
# Add any other environment variables your API needs here
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=password
